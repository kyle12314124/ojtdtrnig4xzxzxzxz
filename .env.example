# ---------------------------------------------------------------------------
# Client environment (Vite) - only PUBLIC values belong here.
# Never put the Supabase service-role key or any secret in VITE_* variables.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (public) key. Safe for the browser: RLS enforces authorization.
VITE_SUPABASE_ANON_KEY=

# Organization identity used on reports and the app shell.
VITE_APP_NAME="Daily Time Record System"
VITE_ORG_NAME="Your Organization"
VITE_ORG_ADDRESS=""
VITE_ORG_LOGO_URL=""

# Timezone used for display and DTR computation (IANA name).
VITE_TIMEZONE="Asia/Manila"
